# Supabase Connect: use the IPv4-compatible session pooler URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
AGENT_EMAIL=agent@requests.brianan.ca
ALLOWED_SENDERS=your-test-address@example.com

# SendGrid Inbound Parse security policy public key (base64 DER).
SENDGRID_INBOUND_PUBLIC_KEY=REPLACE_WITH_PUBLIC_KEY
# Worker key with Mail Send permission.
SENDGRID_API_KEY=REPLACE_WITH_SENDGRID_API_KEY

# Supabase Storage: private bucket and server-side S3 credentials.
SUPABASE_S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_REGION=REPLACE_WITH_PROJECT_REGION
SUPABASE_S3_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY
SUPABASE_S3_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET_KEY
SUPABASE_STORAGE_BUCKET=senpilot-filings

# Optional outside Cloud Run; deployment configures both together.
CLOUD_RUN_JOB=
DISPATCH_TOKEN=
